{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "acme/mago-extension",
  "description": "A project or framework extension for Mago.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Your Name",
      "email": "you@example.com"
    }
  ],
  "keywords": [
    "mago",
    "static-analysis",
    "linter"
  ],
  "require": {
    "php": "^8.1",
    "carthage-software/mago": "^1.47.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "Acme\\Mago\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Acme\\Mago\\Tests\\": "tests/Unit/"
    }
  },
  "config": {
    "allow-plugins": false,
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
